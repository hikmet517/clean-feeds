{
  "manifest_version": 3,
  "name": "Clean Feeds",
  "version": "0.0.2",
  "description": "Feed Reader",
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png"
    },
    "default_title": "Clean Feeds"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clean-feeds@example.com",
      "strict_min_version": "42.0"
    }
  }
}
